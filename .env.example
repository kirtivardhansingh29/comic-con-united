# Upstash Redis (REST) — required for the live quiz room state in production.
# Easiest path: add the Upstash integration from the Vercel Marketplace
# (Storage tab of your Vercel project) — it sets both variables automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Note: if these are empty (local dev only), the app falls back to a
# single-process in-memory store so you can smoke-test on your machine.
# Never run a real event without Upstash configured.
